# HTTP
PORT=8080
# Local: ./data
# Local file storage:
DATA_DIR=./data

# Supabase persistent online storage.
# Run supabase/schema.sql in Supabase SQL Editor first.
SUPABASE_URL=https://thsuhgyarzsxehjldrbf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI assistant.
# OPENAI_API_KEY is required for /api/assistant/message.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5
# Optional. Keep unset unless you use a proxy. Default: https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=45000
OPENAI_MAX_OUTPUT_TOKENS=2500
OPENAI_REASONING_EFFORT=low
OPENAI_TEXT_VERBOSITY=low
# Optional long-term memory layer based on TencentDB Agent Memory.
TENCENT_MEMORY_API_KEY=sk-your-tencent-memory-api-key
TENCENT_MEMORY_SERVICE_ID=tdai-mem-your-instance-id
TENCENT_MEMORY_TEAM_ID=crmzona
TENCENT_MEMORY_AGENT_ID=crmzona-assistant
# Optional. Default: https://memory.tdai.tencentyun.com
# TENCENT_MEMORY_ENDPOINT=https://memory.tdai.tencentyun.com
TENCENT_MEMORY_API_VERSION=v3

# SMTP for automatic password delivery.
# Recommended: SMTP over SSL on port 465.
# If SMTP_HOST/SMTP_PORT are absent or SMTP fails, emails are saved to data/outbox.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mailbox@example.com
SMTP_PASS=change-me
SMTP_FROM=mailbox@example.com

# Google Drive archive for housekeeping expense receipts.
# Prefer a service account JSON and share the target Shared Drive folder with its client_email.
# Service accounts cannot store uploads in their own My Drive because they have no Drive quota.
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id
GOOGLE_DRIVE_EXPENSES_FOLDER_NAME=Хозрасходы
# If you already have the exact Shared Drive expenses folder ID, set it instead of relying on folder creation:
# GOOGLE_DRIVE_EXPENSES_FOLDER_ID=your-expenses-folder-id
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...@....iam.gserviceaccount.com"}
# Alternative for local testing with a short-lived OAuth token:
# GOOGLE_DRIVE_ACCESS_TOKEN=ya29...
# Alternative for regular Google Drive / My Drive uploads with automatic token refresh:
# GOOGLE_DRIVE_CLIENT_ID=your-oauth-client-id
# GOOGLE_DRIVE_CLIENT_SECRET=your-oauth-client-secret
# GOOGLE_DRIVE_REFRESH_TOKEN=your-oauth-refresh-token
