# HTTP
PORT=8080
# Local: ./data
# Local file storage:
DATA_DIR=./data

# Online storage on Vercel:
# Set these in Vercel Project Settings -> Environment Variables.
# Never expose SUPABASE_SERVICE_ROLE_KEY in frontend code.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SMTP for automatic password delivery.
# Recommended: SMTP over SSL on port 465.
# If SMTP_HOST/SMTP_PORT are absent or SMTP fails, emails are saved to data/outbox.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mailbox@example.com
SMTP_PASS=change-me
SMTP_FROM=mailbox@example.com
